# Appwrite — Amos Tech Solutions
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_PAGES_TABLE_ID=pages
VITE_APPWRITE_CONTACT_TABLE_ID=contact_messages
VITE_APPWRITE_QUOTE_TABLE_ID=quote_requests

# Allowed admin emails (comma-separated). Users must also have the Appwrite "admin" label.
VITE_ADMIN_ALLOWED_EMAILS=

# Local reference only — never use VITE_ for passwords
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contentful — Services, Blog, Projects, Events (required; no local fallback)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_DELIVERY_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master
